<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restore resolves from nuget.org and nowhere else. Without <clear/> a source
    configured on the build machine is also consulted, which is how a package
    gets substituted without anything in the repository changing.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
