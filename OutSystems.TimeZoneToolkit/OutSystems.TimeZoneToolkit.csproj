<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- ODC reads the XML doc comments to describe the actions and parameters in ODC Studio. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Time zone lookups need the ICU data shipped with the runtime image. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- ODC runs the library on linux-x64; naming it keeps the lock file stable. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <!-- Restore verifies package hashes against packages.lock.json. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Normalizes source paths in the PDB so a release build is reproducible. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="resources\timezone.png" />
    <EmbeddedResource Include="resources\timezone.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.5.0" />
    <PackageReference Include="TimeZoneConverter" Version="8.0.0" />
  </ItemGroup>

</Project>
